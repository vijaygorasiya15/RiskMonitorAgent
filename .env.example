# Copy to .env (git-ignored). Compose reads it automatically.

# "mock" = free rule-based engine, no AWS needed.  "bedrock" = real LLM (costs a few rupees).
LLM_MODE=mock

# Only needed when LLM_MODE=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
